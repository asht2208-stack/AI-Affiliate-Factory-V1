# --- AI Automation Affiliate V3: environment configuration ---
#
# Copy this file to ".env" (same folder) before running anything.
# ".env" itself should never be committed to version control — only
# this ".env.example" template should be.

ENVIRONMENT=local
LOG_LEVEL=INFO
APP_NAME=AI Automation Affiliate V3
APP_BASE_URL=http://localhost:8000

# --- Database: matches docker-compose.yml exactly. Real, ready to use. ---
DB_DSN=postgresql+asyncpg://affiliate_user:affiliate_pass@localhost:5432/affiliate_v3

# --- Search (OpenSearch): not running yet. Placeholder so the app can
#     still start; anything that actually calls search will fail until
#     you set this up for real, which is fine for now. ---
SEARCH_HOSTS=["http://localhost:9200"]

# --- Cache (Redis): not running yet. Placeholder for the same reason. ---
CACHE_DSN=redis://localhost:6379/0

# --- Object storage (images/backups): not running yet. Placeholder
#     values so settings validation passes; not real credentials. ---
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_ACCESS_KEY_ID=placeholder_access_key
STORAGE_SECRET_ACCESS_KEY=placeholder_secret_key

# --- Task queue (Celery): not running yet. Placeholder for the same reason. ---
QUEUE_BROKER_URL=redis://localhost:6379/1
QUEUE_RESULT_BACKEND_URL=redis://localhost:6379/2

# --- Security: generate real random values before any real deployment.
#     These placeholders are fine ONLY for local testing on your own machine. ---
SECURITY_JWT_SIGNING_KEY=local-dev-only-change-me-jwt-key
SECURITY_AFFILIATE_LINK_SIGNING_KEY=local-dev-only-change-me-link-key

